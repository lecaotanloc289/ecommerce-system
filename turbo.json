{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": ["DOCKER_HOST", "DOCKER_CONFIG", "DOCKER_CONTEXT", "TESTCONTAINERS_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@repo/db#test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL", "SHADOW_DATABASE_URL"],
      "cache": false
    },
    "@repo/db#generate": {
      "cache": false
    },
    "@server/api#openapi:export": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@repo/sdk#generate": {
      "dependsOn": ["@server/api#openapi:export"],
      "cache": false
    }
  }
}
