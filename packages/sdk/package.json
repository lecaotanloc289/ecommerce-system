{
  "name": "@repo/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "lint": "echo 'TODO: eslint'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "openapi-fetch": "^0.17.0",
    "ulid": "^3.0.2"
  },
  "files": [
    "dist",
    "openapi.json"
  ]
}
