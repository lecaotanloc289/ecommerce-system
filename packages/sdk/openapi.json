{
  "components": {
    "schemas": {
      "HealthReadyResponseDto_Output": {
        "additionalProperties": false,
        "properties": {
          "db": {
            "const": "up",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db"
        ],
        "type": "object"
      },
      "HealthResponseDto_Output": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "const": "ok",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "timestamp"
        ],
        "type": "object"
      },
      "MeResponseDto_Output": {
        "additionalProperties": false,
        "properties": {
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "primaryLocale": {
            "enum": [
              "VI",
              "EN"
            ],
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "GUEST",
                "CUSTOMER",
                "VENDOR_OWNER",
                "VENDOR_STAFF",
                "PLATFORM_STAFF",
                "PLATFORM_ADMIN"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "vendorId": {
            "anyOf": [
              {
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "avatarUrl",
          "primaryLocale",
          "roles",
          "vendorId"
        ],
        "type": "object"
      },
      "TokenResponseDto_Output": {
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "minLength": 1,
            "type": "string"
          },
          "expiresIn": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "tokenType": {
            "const": "Bearer",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "refresh-cookie": {
        "in": "cookie",
        "name": "refresh_token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Multi-vendor marketplace REST API (`/v1`).",
    "title": "Marketplace API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/facebook": {
      "get": {
        "operationId": "AuthController_facebookStart",
        "parameters": [
          {
            "in": "query",
            "name": "app",
            "required": false,
            "schema": {
              "enum": [
                "web",
                "admin"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Facebook"
          }
        },
        "summary": "Start Facebook OAuth login (browser navigation, not an XHR call)",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/facebook/callback": {
      "get": {
        "operationId": "AuthController_facebookCallback",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Sets the refresh cookie and redirects to the app (`?error=...` on failure)"
          }
        },
        "summary": "Facebook OAuth callback (browser redirect, not an XHR call)",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/google": {
      "get": {
        "operationId": "AuthController_googleStart",
        "parameters": [
          {
            "in": "query",
            "name": "app",
            "required": false,
            "schema": {
              "enum": [
                "web",
                "admin"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Google"
          }
        },
        "summary": "Start Google OAuth login (browser navigation, not an XHR call)",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/google/callback": {
      "get": {
        "operationId": "AuthController_googleCallback",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Sets the refresh cookie and redirects to the app (`?error=...` on failure)"
          }
        },
        "summary": "Google OAuth callback (browser redirect, not an XHR call)",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Session revoked (idempotent)"
          }
        },
        "security": [
          {
            "refresh-cookie": []
          }
        ],
        "summary": "Revoke the session and clear the refresh cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto_Output"
                }
              }
            },
            "description": "Current user"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Current user profile, effective roles and vendor id",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseDto_Output"
                }
              }
            },
            "description": "New access token"
          }
        },
        "security": [
          {
            "refresh-cookie": []
          }
        ],
        "summary": "Rotate the refresh cookie and return a new access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto_Output"
                }
              }
            },
            "description": "Service is up"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponseDto_Output"
                }
              }
            },
            "description": "Database reachable"
          }
        },
        "summary": "Readiness probe (checks the database)",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
