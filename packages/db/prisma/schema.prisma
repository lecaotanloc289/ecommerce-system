generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  GUEST
  CUSTOMER
  VENDOR_OWNER
  VENDOR_STAFF
  PLATFORM_STAFF
  PLATFORM_ADMIN
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum Locale {
  VI
  EN
}

enum Currency {
  VND
  USD
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  COMPLETED
}

enum SubOrderStatus {
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  VNPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum LedgerAccount {
  CUSTOMER
  PLATFORM_ESCROW
  VENDOR_WALLET
  PLATFORM_REVENUE
}

enum LedgerEntryType {
  ESCROW_IN
  PAYOUT_OUT
  COMMISSION
  REFUND
  ADJUSTMENT
}

enum CouponScope {
  PLATFORM
  VENDOR
}

enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id            String   @id
  email         String?  @unique
  name          String
  avatarUrl     String?  @map("avatar_url")
  primaryLocale Locale   @default(VI) @map("primary_locale")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  oauthIdentities    OAuthIdentity[]
  roles              UserRole[]
  addresses          Address[]
  cart               Cart?
  orders             Order[]
  ownedVendors       Vendor[]            @relation("VendorOwner")
  vendorApplications VendorApplication[] @relation("Applicant")
  reviewedApps       VendorApplication[] @relation("Reviewer")
  reviews            Review[]
  couponRedemptions  CouponRedemption[]

  @@map("users")
}

model OAuthIdentity {
  id             String        @id
  userId         String        @map("user_id")
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  emailVerified  Boolean       @default(false) @map("email_verified")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

model UserRole {
  id        String   @id
  userId    String   @map("user_id")
  role      Role
  vendorId  String?  @map("vendor_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, role, vendorId])
  @@index([vendorId])
  @@map("user_roles")
}

model Address {
  id            String   @id
  userId        String   @map("user_id")
  recipientName String   @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  ward          String
  district      String
  city          String
  country       String   @default("VN")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Vendor {
  id                    String       @id
  ownerId               String       @map("owner_id")
  slug                  String       @unique
  displayName           String       @map("display_name")
  status                VendorStatus @default(PENDING)
  logoUrl               String?      @map("logo_url")
  description           String?
  commissionBpsOverride Int?         @map("commission_bps_override")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  owner           User             @relation("VendorOwner", fields: [ownerId], references: [id])
  staffRoles      UserRole[]
  wallet          Wallet?
  products        Product[]
  shippingMethods ShippingMethod[]
  subOrders       SubOrder[]
  coupons         Coupon[]
  ledgerEntries   LedgerEntry[]

  @@index([ownerId])
  @@map("vendors")
}

model VendorApplication {
  id                 String            @id
  applicantId        String            @map("applicant_id")
  status             ApplicationStatus @default(PENDING)
  businessLicenseUrl String            @map("business_license_url")
  taxId              String            @map("tax_id")
  nationalIdNumber   String            @map("national_id_number")
  nationalIdUrl      String            @map("national_id_url")
  bankName           String            @map("bank_name")
  bankAccountNumber  String            @map("bank_account_number")
  accountHolder      String            @map("account_holder")
  bankVerified       Boolean           @default(false) @map("bank_verified")
  reviewedById       String?           @map("reviewed_by_id")
  reviewedAt         DateTime?         @map("reviewed_at")
  rejectReason       String?           @map("reject_reason")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  applicant  User  @relation("Applicant", fields: [applicantId], references: [id])
  reviewedBy User? @relation("Reviewer", fields: [reviewedById], references: [id])

  @@index([applicantId])
  @@index([status])
  @@index([reviewedById])
  @@map("vendor_applications")
}

model Wallet {
  id              String   @id
  vendorId        String   @unique @map("vendor_id")
  balanceAmount   BigInt   @default(0) @map("balance_amount")
  balanceCurrency Currency @default(VND) @map("balance_currency")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Category {
  id                    String   @id
  parentId              String?  @map("parent_id")
  commissionBpsOverride Int?     @map("commission_bps_override")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id         String   @id
  categoryId String   @map("category_id")
  locale     Locale
  name       String
  slug       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Product {
  id                String        @id
  vendorId          String        @map("vendor_id")
  status            ProductStatus @default(DRAFT)
  basePriceAmount   BigInt        @map("base_price_amount")
  basePriceCurrency Currency      @default(VND) @map("base_price_currency")
  primaryImageUrl   String?       @map("primary_image_url")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  vendor       Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  translations ProductTranslation[]
  categories   ProductCategory[]
  variants     ProductVariant[]
  images       ProductImage[]
  reviews      Review[]

  @@index([vendorId])
  @@index([status])
  @@map("products")
}

model ProductTranslation {
  id           String                   @id
  productId    String                   @map("product_id")
  locale       Locale
  name         String
  slug         String
  description  String?
  searchVector Unsupported("tsvector")? @map("search_vector")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@map("product_translations")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id            String   @id
  productId     String   @map("product_id")
  sku           String   @unique
  attributes    Json     @default("{}")
  priceAmount   BigInt   @map("price_amount")
  priceCurrency Currency @default(VND) @map("price_currency")
  stockOnHand   Int      @default(0) @map("stock_on_hand")
  stockReserved Int      @default(0) @map("stock_reserved")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id
  productId String   @map("product_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Cart {
  id        String   @id
  userId    String?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id
  cartId    String   @map("cart_id")
  variantId String   @map("variant_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                  String      @id
  customerId          String      @map("customer_id")
  status              OrderStatus @default(AWAITING_PAYMENT)
  currency            Currency
  itemsTotalAmount    BigInt      @map("items_total_amount")
  shippingTotalAmount BigInt      @map("shipping_total_amount")
  discountTotalAmount BigInt      @default(0) @map("discount_total_amount")
  grandTotalAmount    BigInt      @map("grand_total_amount")
  idempotencyKey      String      @unique @map("idempotency_key")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  customer          User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subOrders         SubOrder[]
  payments          Payment[]
  ledgerEntries     LedgerEntry[]
  couponRedemptions CouponRedemption[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model SubOrder {
  id               String         @id
  orderId          String         @map("order_id")
  vendorId         String         @map("vendor_id")
  status           SubOrderStatus @default(AWAITING_PAYMENT)
  subtotalAmount   BigInt         @map("subtotal_amount")
  shippingAmount   BigInt         @map("shipping_amount")
  discountAmount   BigInt         @default(0) @map("discount_amount")
  commissionAmount BigInt         @default(0) @map("commission_amount")
  currency         Currency
  shippingMethodId String?        @map("shipping_method_id")
  shippingAddress  Json           @map("shipping_address")
  completedAt      DateTime?      @map("completed_at")
  payoutReleasedAt DateTime?      @map("payout_released_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor            Vendor             @relation(fields: [vendorId], references: [id])
  shippingMethod    ShippingMethod?    @relation(fields: [shippingMethodId], references: [id])
  items             OrderItem[]
  ledgerEntries     LedgerEntry[]
  couponRedemptions CouponRedemption[]
  reviews           Review[]

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
  @@index([shippingMethodId])
  @@map("sub_orders")
}

model OrderItem {
  id                        String   @id
  subOrderId                String   @map("sub_order_id")
  variantId                 String   @map("variant_id")
  productTitleSnapshot      String   @map("product_title_snapshot")
  variantAttributesSnapshot Json     @map("variant_attributes_snapshot")
  unitPriceAmount           BigInt   @map("unit_price_amount")
  quantity                  Int
  lineTotalAmount           BigInt   @map("line_total_amount")
  currency                  Currency
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  subOrder SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([subOrderId])
  @@index([variantId])
  @@map("order_items")
}

model ShippingMethod {
  id            String   @id
  vendorId      String   @map("vendor_id")
  name          String
  priceAmount   BigInt   @map("price_amount")
  priceCurrency Currency @default(VND) @map("price_currency")
  estDays       Int      @map("est_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  subOrders SubOrder[]

  @@index([vendorId])
  @@map("shipping_methods")
}

model Payment {
  id            String          @id
  orderId       String          @map("order_id")
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  amount        BigInt
  currency      Currency
  providerTxnId String?         @map("provider_txn_id")
  rawPayload    Json?           @map("raw_payload")
  attemptNo     Int             @default(1) @map("attempt_no")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, attemptNo])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model LedgerEntry {
  id         String          @id
  txnGroupId String          @map("txn_group_id")
  account    LedgerAccount
  entryType  LedgerEntryType @map("entry_type")
  amount     BigInt
  currency   Currency
  orderId    String?         @map("order_id")
  subOrderId String?         @map("sub_order_id")
  vendorId   String?         @map("vendor_id")
  createdAt  DateTime        @default(now()) @map("created_at")

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subOrder SubOrder? @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([txnGroupId])
  @@index([account, vendorId])
  @@index([orderId])
  @@index([subOrderId])
  @@index([vendorId])
  @@map("ledger_entries")
}

model Coupon {
  id             String       @id
  scope          CouponScope
  vendorId       String?      @map("vendor_id")
  code           String
  discountType   DiscountType @map("discount_type")
  discountValue  BigInt       @map("discount_value")
  minSpendAmount BigInt?      @map("min_spend_amount")
  currency       Currency?
  maxRedemptions Int?         @map("max_redemptions")
  perUserLimit   Int?         @map("per_user_limit")
  startsAt       DateTime     @map("starts_at")
  endsAt         DateTime     @map("ends_at")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  vendor      Vendor?            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@unique([vendorId, code])
  @@index([scope])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id
  couponId       String   @map("coupon_id")
  userId         String   @map("user_id")
  orderId        String?  @map("order_id")
  subOrderId     String?  @map("sub_order_id")
  discountAmount BigInt   @map("discount_amount")
  currency       Currency
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  subOrder SubOrder? @relation(fields: [subOrderId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@index([subOrderId])
  @@map("coupon_redemptions")
}

model Review {
  id         String   @id
  productId  String   @map("product_id")
  authorId   String   @map("author_id")
  subOrderId String   @map("sub_order_id")
  rating     Int
  body       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  subOrder SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Restrict)

  @@unique([authorId, subOrderId, productId])
  @@index([productId])
  @@map("reviews")
}

model PlatformSettings {
  id                  String     @id
  commissionBps       Int        @default(1000) @map("commission_bps")
  holdPeriodDays      Int        @default(7) @map("hold_period_days")
  refundWindowDays    Int        @default(7) @map("refund_window_days")
  maxCouponStack      Int        @default(1) @map("max_coupon_stack")
  supportedCurrencies Currency[] @map("supported_currencies")
  defaultCurrency     Currency   @default(VND) @map("default_currency")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model OutboxEvent {
  id            String    @id
  aggregateId   String    @map("aggregate_id")
  aggregateType String    @map("aggregate_type")
  eventType     String    @map("event_type")
  payload       Json      @default("{}")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  @@index([processedAt])
  @@map("outbox_events")
}
