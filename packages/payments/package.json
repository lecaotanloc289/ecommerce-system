{
  "name": "@repo/payments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vnpay": {
      "types": "./dist/vnpay/index.d.ts",
      "import": "./dist/vnpay/index.js",
      "require": "./dist/vnpay/index.cjs"
    },
    "./stripe": {
      "types": "./dist/stripe/index.d.ts",
      "import": "./dist/stripe/index.js",
      "require": "./dist/stripe/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^10.15.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "stripe": "23.1.0"
  }
}
