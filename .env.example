# =============================================================================
# Node / runtime
# =============================================================================
NODE_ENV=development

# =============================================================================
# Database (Postgres 16)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public
# Prisma shadow DB for migrate dev (drift detection)
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_shadow?schema=public

# =============================================================================
# Redis (cache + BullMQ)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Object storage (RustFS local / R2 prod) — S3-compatible
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true
# `kyc` = private (presigned GET only), `media` = public read. Created by the `s3-init` compose job.
S3_BUCKET_KYC=kyc
S3_BUCKET_MEDIA=media
# Public base URL of the media bucket; object key (`media/vendors/...`) is appended. Prod: R2 custom domain.
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/media

# =============================================================================
# Auth (JWT — Golden Rule #5)
# =============================================================================
# Generate with: openssl rand -base64 32
# The API validates its env with Zod at boot (server/src/config/env.ts) and refuses to start on a
# missing/invalid key: secrets >= 32 chars, access != refresh, no `change-me...` in production.
# OAuth client IDs/secrets and REDIS_URL (refresh-token sessions) are required too.
JWT_ACCESS_SECRET=change-me-access-32-byte-random-base64
JWT_REFRESH_SECRET=change-me-refresh-32-byte-random-base64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# =============================================================================
# CRM (vendor customer messaging)
# =============================================================================
# HMAC key for per-(customer, shop) unsubscribe tokens in CRM emails; >= 32 chars; placeholder
# rejected in production; rotating it invalidates every unsubscribe link already sent.
CRM_UNSUBSCRIBE_SECRET=change-me-crm-unsubscribe-32-byte-random

# =============================================================================
# OAuth — Google
# =============================================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# =============================================================================
# OAuth — Facebook
# =============================================================================
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CALLBACK_URL=http://localhost:3001/v1/auth/facebook/callback

# =============================================================================
# CORS — allowed origins for credentials
# =============================================================================
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173

# =============================================================================
# OAuth login landing pages — the API callback sets the refresh cookie, then redirects here
# (`?app=web|admin` on /v1/auth/<provider> picks one); on failure `?error=<errorCode>` is appended.
# The app then calls POST /v1/auth/refresh to get its in-memory access token.
# =============================================================================
AUTH_REDIRECT_URL_WEB=http://localhost:3000/auth/callback
AUTH_REDIRECT_URL_ADMIN=http://localhost:5173/auth/callback

# =============================================================================
# Rate limit (@fastify/rate-limit, Redis-backed, per client IP and window)
# Default bucket is shared by all routes; `@RateLimit('strict')` routes (auth, checkout,
# payments) each get their own smaller bucket. Over the limit → 429 common.error.rate-limited.
# =============================================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_STRICT_MAX=20
# Per-IP limit for POST /v1/crm/unsubscribe per RATE_LIMIT_WINDOW.
RATE_LIMIT_UNSUBSCRIBE_MAX=60
RATE_LIMIT_WINDOW=1m
# Proxies in front of the API that append to X-Forwarded-For (Fly.io edge = 1). The client IP is
# that many entries in from the socket peer; entries further left are spoofable. 0 = no proxy.
TRUSTED_PROXY_HOPS=0

# =============================================================================
# Zalo worker (workers/zalo — zca-js sessions + automated order messages). See workers/zalo/CLAUDE.md.
# Uses DATABASE_URL + REDIS_URL above. The key encrypts stored Zalo sessions (AES-256-GCM);
# generate with: openssl rand -base64 32 — rotating it forces every shop to re-scan the QR.
# =============================================================================
ZALO_CREDENTIALS_KEY=
# Optional tuning (defaults shown):
# ZALO_POLL_INTERVAL_MS=1000
# ZALO_ACCOUNT_SYNC_INTERVAL_MS=10000
# ZALO_KEEPALIVE_INTERVAL_MS=300000
# ZALO_SEND_MIN_INTERVAL_MS=3000
# ZALO_MESSAGE_MAX_AGE_HOURS=24
# ZALO_MAX_SEND_ATTEMPTS=5
# ZALO_MESSAGE_RETENTION_DAYS=90
# ZALO_CALL_TIMEOUT_MS=20000
# ZALO_MAX_SESSION_FAILURES=3
# ZALO_MAX_CONCURRENT_LOGINS=5
# ZALO_QR_LOGIN_TIMEOUT_MS=180000

# =============================================================================
# Payment — VNPay (VN, VND only). Read by server/workers and passed to
# createVnpayProvider() from @repo/payments (the package never reads env).
# The API only verifies callbacks (IPN + browser return): VNPay is enabled when VNPAY_TMN_CODE and
# VNPAY_HASH_SECRET are set; otherwise GET /v1/payments/webhook/vnpay answers 503 (boot still succeeds).
# =============================================================================
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Hosted payment page the customer is redirected to.
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Merchant web API (refund / querydr).
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Browser return after paying: the API route verifies the signature, then redirects to the web app.
VNPAY_RETURN_URL=http://localhost:3001/v1/payments/return/vnpay

# =============================================================================
# Payment — Stripe (international). Passed to createStripeProvider() from @repo/payments.
# The API enables Stripe when STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set (else its webhook
# answers 503). Webhook endpoint: POST <api>/v1/payments/webhook/stripe (events checkout.session.*).
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# Email (Mailhog dev / SES prod)
# =============================================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ecommerce <no-reply@ecommerce.local>"

# =============================================================================
# Worker (workers/jobs, @workers/jobs) — outbox dispatcher (payment sessions, refunds, emails)
# + scheduled jobs (payment expiry, auto-complete, payouts, outbox retention).
# Also reads DATABASE_URL, REDIS_URL, WEB_ORIGIN, ADMIN_ORIGIN, SMTP_*, VNPAY_* (TMN_CODE,
# HASH_SECRET, PAY_URL, API_URL) and STRIPE_SECRET_KEY above. A provider whose keys are blank is
# disabled: its payment.requested / refund.requested events are dead-lettered, the worker still runs.
# =============================================================================
# Public API origin; VNPay sends the browser back to ${API_PUBLIC_URL}/v1/payments/return/vnpay.
API_PUBLIC_URL=http://localhost:3001
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
# Events handled in parallel; each holds a DB connection while its handler runs.
OUTBOX_CONCURRENCY=2
# Scheduled jobs (BullMQ repeatable): repeat intervals in ms.
JOB_EXPIRE_UNPAID_ORDERS_EVERY_MS=60000
JOB_AUTO_COMPLETE_SUB_ORDERS_EVERY_MS=3600000
JOB_RELEASE_PAYOUTS_EVERY_MS=3600000
JOB_OUTBOX_RETENTION_EVERY_MS=86400000
# Rows read per page by a job (each row is still its own transaction).
JOB_BATCH_SIZE=100
# Processed outbox rows older than this are deleted (unprocessed / dead-lettered rows never are).
OUTBOX_RETENTION_DAYS=30

# =============================================================================
# Web (Next.js, apps/web) — anything NEXT_PUBLIC_* is shipped to the browser
# =============================================================================
# API origin WITHOUT /v1 (the SDK paths include it). Read by the browser; inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional server-side (SSR) override, e.g. an internal URL the Worker can reach. Defaults to NEXT_PUBLIC_API_URL.
# API_URL=
# Admin app origin (seller portal). The storefront's /sell page links an approved vendor to <origin>/vendor. Inlined at build time.
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173

# =============================================================================
# Admin (Vite, apps/admin) — anything VITE_* is shipped to the browser
# =============================================================================
# API origin WITHOUT /v1 (the generated @repo/sdk paths already start with /v1; a trailing
# /v1 is stripped anyway). Inlined at build time from this root .env (vite envDir) or the shell env.
VITE_API_URL=http://localhost:3001

# =============================================================================
# CI/CD secrets — NOT loaded at runtime; documented here for reference only.
# Stored in GitHub Actions repo secrets (Settings → Secrets and variables → Actions).
# Every runtime key above must exist with both _DEV and _PROD suffixes.
# =============================================================================
#
# Cloudflare (shared across both envs):
#   CLOUDFLARE_API_TOKEN          — scoped to "Pages: Edit"
#   CLOUDFLARE_ACCOUNT_ID
#
# Fly.io (shared):
#   FLY_API_TOKEN                 — `fly tokens create deploy`
#
# Per-env duplicates of runtime keys (suffix _DEV / _PROD):
#   DATABASE_URL_{DEV,PROD}
#   SHADOW_DATABASE_URL_{DEV,PROD}
#   REDIS_URL_{DEV,PROD}
#   JWT_ACCESS_SECRET_{DEV,PROD}
#   JWT_REFRESH_SECRET_{DEV,PROD}
#   CRM_UNSUBSCRIBE_SECRET_{DEV,PROD}
#   GOOGLE_OAUTH_CLIENT_ID_{DEV,PROD}
#   GOOGLE_OAUTH_CLIENT_SECRET_{DEV,PROD}
#   FACEBOOK_OAUTH_CLIENT_ID_{DEV,PROD}
#   FACEBOOK_OAUTH_CLIENT_SECRET_{DEV,PROD}
#   VNPAY_TMN_CODE_{DEV,PROD}
#   VNPAY_HASH_SECRET_{DEV,PROD}
#   STRIPE_SECRET_KEY_{DEV,PROD}
#   STRIPE_WEBHOOK_SECRET_{DEV,PROD}
#   S3_ENDPOINT_{DEV,PROD}
#   S3_ACCESS_KEY_ID_{DEV,PROD}
#   S3_SECRET_ACCESS_KEY_{DEV,PROD}
#   S3_BUCKET_KYC_{DEV,PROD}
#   S3_BUCKET_MEDIA_{DEV,PROD}
#   MEDIA_PUBLIC_BASE_URL_{DEV,PROD}
#   SMTP_HOST_{DEV,PROD}
#   SMTP_USER_{DEV,PROD}
#   SMTP_PASS_{DEV,PROD}
#
# Frontend-public URLs are injected at build time by the workflows
# (NEXT_PUBLIC_API_URL, VITE_API_URL) — not secrets, derived from
# github.ref_name → `https://elma-api-${ref_name}.fly.dev`.
#
# Mirror the per-env keys to Fly:
#   fly secrets set --app elma-api-dev  DATABASE_URL=... REDIS_URL=... ...
#   fly secrets set --app elma-api-prod DATABASE_URL=... REDIS_URL=... ...
#   fly secrets set --app elma-worker-{dev,prod} DATABASE_URL=... REDIS_URL=... SMTP_*=... VNPAY_*=... STRIPE_SECRET_KEY=... API_PUBLIC_URL=... WEB_ORIGIN=... ADMIN_ORIGIN=...
