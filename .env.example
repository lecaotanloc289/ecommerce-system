# =============================================================================
# Node / runtime
# =============================================================================
NODE_ENV=development

# =============================================================================
# Database (Postgres 16)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public
# Prisma shadow DB for migrate dev (drift detection)
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_shadow?schema=public

# =============================================================================
# Redis (cache + BullMQ)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Object storage (MinIO local / R2 prod) — S3-compatible
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ecommerce
S3_FORCE_PATH_STYLE=true

# =============================================================================
# Auth (JWT — Golden Rule #5)
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access-32-byte-random-base64
JWT_REFRESH_SECRET=change-me-refresh-32-byte-random-base64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# =============================================================================
# OAuth — Google
# =============================================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# =============================================================================
# OAuth — Facebook
# =============================================================================
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CALLBACK_URL=http://localhost:3001/v1/auth/facebook/callback

# =============================================================================
# CORS — allowed origins for credentials
# =============================================================================
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173

# =============================================================================
# Payment — VNPay (VN)
# =============================================================================
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/vi/checkout/return/vnpay
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# =============================================================================
# Payment — Stripe (international)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# Email (Mailhog dev / SES prod)
# =============================================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ecommerce <no-reply@ecommerce.local>"

# =============================================================================
# Web (Next.js, apps/web) — anything NEXT_PUBLIC_* is shipped to the browser
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# =============================================================================
# Admin (Vite, apps/admin) — anything VITE_* is shipped to the browser
# =============================================================================
VITE_API_URL=http://localhost:3001/v1

# =============================================================================
# CI/CD secrets — NOT loaded at runtime; documented here for reference only.
# Stored in GitHub Actions repo secrets (Settings → Secrets and variables → Actions).
# Every runtime key above must exist with both _DEV and _PROD suffixes.
# =============================================================================
#
# Cloudflare (shared across both envs):
#   CLOUDFLARE_API_TOKEN          — scoped to "Pages: Edit"
#   CLOUDFLARE_ACCOUNT_ID
#
# Fly.io (shared):
#   FLY_API_TOKEN                 — `fly tokens create deploy`
#
# Per-env duplicates of runtime keys (suffix _DEV / _PROD):
#   DATABASE_URL_{DEV,PROD}
#   SHADOW_DATABASE_URL_{DEV,PROD}
#   REDIS_URL_{DEV,PROD}
#   JWT_ACCESS_SECRET_{DEV,PROD}
#   JWT_REFRESH_SECRET_{DEV,PROD}
#   GOOGLE_OAUTH_CLIENT_ID_{DEV,PROD}
#   GOOGLE_OAUTH_CLIENT_SECRET_{DEV,PROD}
#   FACEBOOK_OAUTH_CLIENT_ID_{DEV,PROD}
#   FACEBOOK_OAUTH_CLIENT_SECRET_{DEV,PROD}
#   VNPAY_TMN_CODE_{DEV,PROD}
#   VNPAY_HASH_SECRET_{DEV,PROD}
#   STRIPE_SECRET_KEY_{DEV,PROD}
#   STRIPE_WEBHOOK_SECRET_{DEV,PROD}
#   SMTP_HOST_{DEV,PROD}
#   SMTP_USER_{DEV,PROD}
#   SMTP_PASS_{DEV,PROD}
#
# Frontend-public URLs are injected at build time by the workflows
# (NEXT_PUBLIC_API_URL, VITE_API_URL) — not secrets, derived from
# github.ref_name → `https://elma-api-${ref_name}.fly.dev`.
#
# Mirror the per-env keys to Fly:
#   fly secrets set --app elma-api-dev  DATABASE_URL=... REDIS_URL=... ...
#   fly secrets set --app elma-api-prod DATABASE_URL=... REDIS_URL=... ...
