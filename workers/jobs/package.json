{
  "name": "@workers/jobs",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: outbox dispatcher (payment sessions, refunds, transactional email) + scheduled jobs. See CLAUDE.md.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "run-job": "node --enable-source-maps dist/run-job.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/payments": "workspace:*",
    "bullmq": "6.7.6",
    "ioredis": "^5.11.1",
    "nodemailer": "10.6.0",
    "pino": "^10.3.1",
    "stripe": "23.1.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.15.0",
    "testcontainers": "^12.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
